{
  "name": "nestjs-api-boilerplate",
  "version": "0.0.1",
  "description": "A secure NestJS 12 API boilerplate for TypeScript applications.",
  "author": "AutanaSoft",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@12.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AutanaSoft/nestjs-api-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/AutanaSoft/nestjs-api-boilerplate/issues"
  },
  "homepage": "https://github.com/AutanaSoft/nestjs-api-boilerplate#readme",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write . && pnpm lint:md",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed -- --environment development",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/",
    "lint:md": "markdownlint-cli2 \"**/*.{md,mdx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:shutdown-process": "pnpm build && pnpm exec vitest run --config ./vitest.config.shutdown-process.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "0.45.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "18.0.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
