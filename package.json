{
  "name": "nestjs-api-boilerplate",
  "version": "0.0.1",
  "description": "A secure NestJS 12 API boilerplate for TypeScript applications.",
  "author": "AutanaSoft",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AutanaSoft/nestjs-api-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/AutanaSoft/nestjs-api-boilerplate/issues"
  },
  "homepage": "https://github.com/AutanaSoft/nestjs-api-boilerplate#readme",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write . && pnpm lint:md",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/",
    "lint:md": "markdownlint-cli2 \"**/*.{md,mdx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "markdownlint-cli2": "0.23.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^1.5.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
